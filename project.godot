[internationalization]

locale/translations=PackedStringArray("res://data/i18n/strings.pt_PT.translation", "res://data/i18n/strings.en.translation")

[layer_names]

2d_physics/layer_1="aerial"
2d_physics/layer_2="surface"
2d_physics/layer_3="under"
2d_physics/layer_4="terrain"
2d_physics/layer_5="building"
2d_physics/layer_6="coin"

[physics]

common/physics_ticks_per_second=30

[rendering]

textures/canvas_textures/default_texture_filter=0
renderer/rendering_method="mobile"
environment/defaults/default_clear_color=Color(0.063, 0.051, 0.035, 1)
