; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Empire"
config/description="Kingdom-builder 2D em pixel art — ver AGENTS.md e docs/dossie.html"
run/main_scene="res://scenes/boot.tscn"
config/features=PackedStringArray("4.6", "Mobile")

[autoload]

EventBus="*res://src/core/event_bus.gd"
ClockService="*res://src/core/clock_service.gd"
RngService="*res://src/core/rng_service.gd"
Registry="*res://src/core/registry.gd"
SaveService="*res://src/core/save_service.gd"
SimLoop="*res://src/core/sim_loop.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"

[editor_plugins]

enabled=PackedStringArray("res://addons/gdUnit4/plugin.cfg")

